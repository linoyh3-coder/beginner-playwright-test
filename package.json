{
  "name": "ui-google-tests",
  "version": "1.0.0",
  "description": "habibi",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "game": "node server.js",
    "test": "playwright test",
    "test:game": "playwright test tests/game --project=chromium",
    "test:watch": "set SLOWMO=700&& playwright test tests/game --project=chromium --headed --workers=1",
    "test:record": "set VIDEO=1&& playwright test tests/game --project=chromium --trace on",
    "record": "playwright codegen http://127.0.0.1:3000",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
